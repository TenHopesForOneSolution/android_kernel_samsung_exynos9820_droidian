# S10e additions to Droidian's official 4.14-android Halium fragments.
# Keep Samsung's hardware drivers and the boot-partition ramdisk loader.
CONFIG_LOCALVERSION="-droidian-s10e"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=n
CONFIG_FONT_8x16=y
CONFIG_FONT_16x32=y
CONFIG_AUTOFS4_FS=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=0
# EROFS vendor/odm are present on this particular phone.
CONFIG_EROFS_FS=y
# Keep a self-contained Image for the first bring-up.
CONFIG_DEBUG_INFO=n
CONFIG_MODULES=y
# Samsung S-Boot does not propagate the boot.img header command line reliably.
# Extend its hardware-specific DT bootargs rather than replacing those values.
CONFIG_CMDLINE="androidboot.boot_devices=13d60000.ufs console=tty0 boot=halium datapart=/dev/sda34 droidian.lvm.disable selinux=0 androidboot.selinux=permissive loglevel=7 log_buf_len=4M panic=0"
CONFIG_CMDLINE_EXTEND=y

# Build dm-crypt with the kernel; ship the matching module for early unlock.
CONFIG_DM_CRYPT=m
